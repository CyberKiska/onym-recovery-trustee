# TLS in front of the three trustees. Caddy obtains and renews certificates
# itself: Let's Encrypt for public names, its own CA for localhost. No site
# configures an access log, and the default log keeps no client address,
# URI or header.
{
	email {$CADDY_EMAIL}
	# Without an access log, Caddy still logs each failed request (a trustee
	# that is down answers 502) with the client's address, URI and headers.
	# Keep the record for diagnosis; drop what identifies the client.
	log default {
		format filter {
			wrap json
			request>remote_ip delete
			request>remote_port delete
			request>client_ip delete
			request>uri delete
			request>headers delete
			request>tls delete
		}
	}
	servers {
		# TCP only: no UDP port is published, so HTTP/3 is not offered.
		protocols h1 h2
		# A slow client is cut off before it can hold a connection open.
		timeouts {
			read_header 10s
			read_body 30s
			write 30s
			idle 2m
		}
	}
}

(trustee) {
	# The service refuses larger bodies too; see `maximumRequestBytes` in
	# its manifest.
	request_body {
		max_size 128KB
	}
	reverse_proxy {args[0]}:8080 {
		# The service decides one request at a time; the rest wait here,
		# not as buffered bodies inside it.
		transport http {
			max_conns_per_host 8
		}
	}
}

{$TRUSTEE_A_HOST} {
	import trustee trustee-a
}

{$TRUSTEE_B_HOST} {
	import trustee trustee-b
}

{$TRUSTEE_C_HOST} {
	import trustee trustee-c
}
