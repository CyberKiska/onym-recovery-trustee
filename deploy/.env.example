# Copy to .env and fill in. Nothing here is secret: keys live in secrets/.

# Three public names, each resolving directly to this host.
TRUSTEE_A_HOST=trustee-a.example.org
TRUSTEE_B_HOST=trustee-b.example.org
TRUSTEE_C_HOST=trustee-c.example.org

# The Let's Encrypt account address.
CADDY_EMAIL=ops@example.org

# One operator is one trust domain; all three trustees declare it.
TRUST_DOMAIN=example.org

# Component IDs become onym:component:<prefix>-a, -b and -c. They are bound
# into every enrollment: never change them once holders have enrolled.
COMPONENT_PREFIX=example-recovery-trustee

# Where a holder raises a complaint, and the jurisdiction you declare.
CONTACT=mailto:ops@example.org
JURISDICTION=none

# The shortest cooldown a holder's policy may set.
MIN_COOLDOWN=PT1M
